---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Santiago Locaso | Diseño y desarrollo web",
  description = "Diseño y desarrollo sitios web modernos, profesionales y personalizados para empresas, profesionales y organizaciones.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />
    <meta name="author" content="Santiago Locaso" />
    <meta name="theme-color" content="#06101e" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />

    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
