---
import MainLayout from "../layouts/MainLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/services";
---

<MainLayout
  title="Servicios de desarrollo web | Santiago Locaso"
  description="Servicios de diseño y desarrollo web para profesionales, empresas, organizaciones y emprendimientos."
>
  <section class="services-hero">
    <div class="container services-hero-content">
      <span class="section-eyebrow"> Servicios </span>

      <h1>
        Soluciones web pensadas para
        <span>cada etapa de tu proyecto.</span>
      </h1>

      <p>
        Desarrollo sitios personalizados y acompaño cada proyecto desde la
        organización inicial hasta la publicación y puesta en funcionamiento.
      </p>
    </div>
  </section>

  <section class="services-section">
    <div class="container services-grid">
      {
        services.map((service) => (
          <ServiceCard service={service} variant="light" detailed={true} />
        ))
      }
    </div>
  </section>

  <section class="additional-services">
    <div class="container additional-services-container">
      <div class="additional-services-heading">
        <span class="section-eyebrow"> Acompañamiento completo </span>

        <h2>
          También me encargo de los aspectos técnicos necesarios para publicar
          tu sitio.
        </h2>
      </div>

      <div class="additional-services-list">
        <article>
          <span>01</span>

          <div>
            <h3>Dominio y hosting</h3>
            <p>
              Configuración del dominio, DNS, alojamiento y conexión con la
              plataforma elegida.
            </p>
          </div>
        </article>

        <article>
          <span>02</span>

          <div>
            <h3>Publicación y pruebas</h3>
            <p>
              Revisión en computadoras y celulares antes de poner el sitio
              disponible al público.
            </p>
          </div>
        </article>

        <article>
          <span>03</span>

          <div>
            <h3>Soporte inicial</h3>
            <p>
              Acompañamiento durante la puesta en marcha y explicación del
              funcionamiento del sitio.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="services-contact">
    <div class="container services-contact-container">
      <div>
        <span>¿No sabés qué tipo de sitio necesitás?</span>

        <h2>Contame tu idea y buscamos juntos la mejor solución.</h2>
      </div>

      <a href="/contacto" class="button button-primary">
        Contame tu proyecto

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"></path>
        </svg>
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .services-hero {
    position: relative;
    overflow: hidden;
    padding: 110px 0 105px;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(23, 105, 255, 0.13),
        transparent 28%
      ),
      linear-gradient(180deg, #ffffff 0%, #f5f8fc 100%);
  }

  .services-hero::before {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(23, 105, 255, 0.15),
      transparent
    );
    content: "";
  }

  .services-hero-content {
    position: relative;
    z-index: 1;
  }

  h1 {
    max-width: 970px;
    margin-bottom: 28px;
    font-size: clamp(3.3rem, 7vw, 6.7rem);
    letter-spacing: -0.065em;
  }

  h1 span {
    display: block;
    color: var(--color-primary);
  }

  .services-hero p {
    max-width: 700px;
    margin-bottom: 0;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
  }

  .services-section {
    padding: 115px 0 125px;
    background: #ffffff;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .additional-services {
    padding: 110px 0;
    background: var(--color-surface);
  }

  .additional-services-container {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    gap: 100px;
  }

  .additional-services-heading h2 {
    margin-bottom: 0;
    font-size: clamp(2.3rem, 4vw, 3.8rem);
  }

  .additional-services-list {
    display: grid;
  }

  .additional-services-list article {
    display: grid;
    grid-template-columns: 45px 1fr;
    gap: 18px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .additional-services-list article:first-child {
    padding-top: 5px;
  }

  .additional-services-list article > span {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .additional-services-list h3 {
    margin-bottom: 8px;
    font-size: 1.12rem;
  }

  .additional-services-list p {
    margin-bottom: 0;
    font-size: 0.9rem;
  }

  .services-contact {
    padding: 95px 0;
    background: var(--color-dark);
  }

  .services-contact-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 70px;
  }

  .services-contact-container > div > span {
    display: block;
    margin-bottom: 16px;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .services-contact h2 {
    max-width: 760px;
    margin-bottom: 0;
    color: #ffffff;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
  }

  .services-contact .button {
    flex-shrink: 0;
  }

  .services-contact svg {
    width: 19px;
    height: 19px;
  }

  @media (max-width: 900px) {
    .services-hero {
      padding: 90px 0;
    }

    .services-section {
      padding: 90px 0 100px;
    }

    .additional-services {
      padding: 90px 0;
    }

    .additional-services-container {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .services-contact-container {
      align-items: flex-start;
      flex-direction: column;
      gap: 35px;
    }
  }

  @media (max-width: 700px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .services-hero {
      padding: 70px 0 76px;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 4.5rem);
    }

    .services-section {
      padding: 75px 0 84px;
    }

    .additional-services {
      padding: 76px 0;
    }

    .additional-services-list article {
      grid-template-columns: 34px 1fr;
      gap: 12px;
    }

    .services-contact {
      padding: 72px 0;
    }
  }
</style>
